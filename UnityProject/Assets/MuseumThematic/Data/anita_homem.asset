  title: O homem amarelo
  artist: Anita Malfatti
  year: 1916
  movement: Modernismo brasileiro
  periodo: "1915\u20131916 \xB7 antes da Semana"
  tecnica: Pintura
  categoria: pintura
  relacao_com_a_semana_de_1922: "Obra anterior \xE0 Semana, apresentada no evento
