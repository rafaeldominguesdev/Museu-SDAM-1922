  title: Manifesto da Poesia Pau-Brasil
  artist: Oswald de Andrade
  year: 1924
  movement: Modernismo brasileiro
  periodo: "1924 \xB7 depois da Semana"
  tecnica: "Painel did\xE1tico"
  categoria: manifesto
  relacao_com_a_semana_de_1922: "Desdobramento da renova\xE7\xE3o modernista. N\xE3o
